generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Initial domain model only. Financial flows require reviewed, transactional services
// and idempotency before any real deposits, withdrawals, or wagers are enabled.
enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAWAL
  BET_DEBIT
  BET_SETTLEMENT
  ADJUSTMENT
}

enum LedgerEntryStatus {
  PENDING
  POSTED
  FAILED
  REVERSED
}

model User {
  id           String        @id @default(cuid())
  phone        String?       @unique
  email        String?       @unique
  passwordHash String?
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  wallet       Wallet?
  ledger       LedgerEntry[]
  @@index([status, createdAt])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("UGX")
  // Balance is maintained by a reviewed ledger service; do not update from client input.
  balance   BigInt   @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model LedgerEntry {
  id                String            @id @default(cuid())
  userId            String
  type              LedgerEntryType
  status            LedgerEntryStatus @default(PENDING)
  amountMinor       BigInt
  currency          String            @default("UGX")
  idempotencyKey    String            @unique
  providerReference String?           @unique
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, type, createdAt])
}
